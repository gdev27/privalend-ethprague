# Base Sepolia — copy to `.env` in this folder before deploying:
#   Windows:  copy .env.example .env
#   Unix:     cp .env.example .env
# Then edit at least PRIVATE_KEY (and MATCHER if you use a different matcher EOA).
# `.env` is gitignored; never commit real keys.

# Used by foundry.toml [rpc_endpoints] base_sepolia
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Deployer EOA private key (hex, 0x prefix). Default below is the well-known Hardhat #0 key — OK for throwaway testnet only; replace for anything non-public.
PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# EOA authorized as matcher on MatchingCoordinator (must match a key you control on-chain).
# Default matches Hardhat #0 / PRIVATE_KEY above.
MATCHER_ADDRESS=0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266

# Borrow asset = Circle test USDC; collateral = canonical WETH on Base Sepolia.
DEBT_TOKEN=0x036CbD53842c5426634e7929541eC2318f3dCF7e
COLLATERAL_TOKEN=0x4200000000000000000000000000000000000006

# Chainlink AggregatorV3 proxy addresses (Base Sepolia), aligned with bgd-labs/aave-address-book per-asset sources (USDC/USD and ETH/USD style feeds).
DEBT_FEED=0xd30e2101a97dcbAeBCBC04F14C3f624E67A35165
COLLATERAL_FEED=0x4aDC67696bA383F43DD60A9e78F2C97Fbbfc7cb1

# One staleness window is applied to both feeds in Deploy.s.sol — set >= the larger feed heartbeat on this network (plus buffer).
MAX_ORACLE_STALENESS=100000

# Optional (defaults in script: 5000, 500)
# CLOSE_FACTOR_BPS=5000
# LIQUIDATION_BONUS_BPS=500
